<?xml version="1.0"?>
<sdf version="1.9">
  <world name="grasp_test">
    <physics name="default" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>
    <include><name>worktable_1</name><uri>model://grasp_worktable</uri><pose>1.3 -4 -0.034 0 0 0</pose></include>
    <include><name>worktable_2</name><uri>model://grasp_worktable</uri><pose>1.3 -2 -0.034 0 0 0</pose></include>
    <include><name>worktable</name><uri>model://grasp_worktable</uri><pose>1.3 0 -0.034 0 0 0</pose></include>
    <include><name>worktable_4</name><uri>model://grasp_worktable</uri><pose>1.3 2 -0.034 0 0 0</pose></include>
    <include><name>worktable_5</name><uri>model://grasp_worktable</uri><pose>1.3 4 -0.034 0 0 0</pose></include>

    <include><name>sample_box_1</name><uri>model://manipulation_box</uri><pose>1.1 -4.2 0.94 0 0 0</pose></include>
    <include><name>sample_cylinder_1</name><uri>model://manipulation_cylinder</uri><pose>1.5 -4.2 0.94 0 0 0</pose></include>
    <include><name>sample_sphere_1</name><uri>model://manipulation_sphere</uri><pose>1.3 -4 0.94 0 0 0</pose></include>
    <include><name>sample_block_1</name><uri>model://manipulation_block</uri><pose>1.1 -3.8 0.94 0 0 0</pose></include>
    <include><name>sample_bottle_1</name><uri>model://manipulation_bottle</uri><pose>1.5 -3.8 0.94 0 0 0</pose></include>

    <include><name>sample_box_2</name><uri>model://manipulation_box</uri><pose>1.1 -2.2 0.94 0 0 0</pose></include>
    <include><name>sample_cylinder_2</name><uri>model://manipulation_cylinder</uri><pose>1.5 -2.2 0.94 0 0 0</pose></include>
    <include><name>sample_sphere_2</name><uri>model://manipulation_sphere</uri><pose>1.3 -2 0.94 0 0 0</pose></include>
    <include><name>sample_block_2</name><uri>model://manipulation_block</uri><pose>1.1 -1.8 0.94 0 0 0</pose></include>
    <include><name>sample_bottle_2</name><uri>model://manipulation_bottle</uri><pose>1.5 -1.8 0.94 0 0 0</pose></include>

    <include><name>sample_box</name><uri>model://manipulation_box</uri><pose>1.1 -0.2 0.94 0 0 0</pose></include>
    <include><name>sample_cylinder</name><uri>model://manipulation_cylinder</uri><pose>1.5 -0.2 0.94 0 0 0</pose></include>
    <include><name>sample_sphere_3</name><uri>model://manipulation_sphere</uri><pose>1.3 0 0.94 0 0 0</pose></include>
    <include><name>sample_block_3</name><uri>model://manipulation_block</uri><pose>1.1 0.2 0.94 0 0 0</pose></include>
    <include><name>sample_bottle_3</name><uri>model://manipulation_bottle</uri><pose>1.5 0.2 0.94 0 0 0</pose></include>

    <include><name>sample_box_4</name><uri>model://manipulation_box</uri><pose>1.1 1.8 0.94 0 0 0</pose></include>
    <include><name>sample_cylinder_4</name><uri>model://manipulation_cylinder</uri><pose>1.5 1.8 0.94 0 0 0</pose></include>
    <include><name>sample_sphere_4</name><uri>model://manipulation_sphere</uri><pose>1.3 2 0.94 0 0 0</pose></include>
    <include><name>sample_block_4</name><uri>model://manipulation_block</uri><pose>1.1 2.2 0.94 0 0 0</pose></include>
    <include><name>sample_bottle_4</name><uri>model://manipulation_bottle</uri><pose>1.5 2.2 0.94 0 0 0</pose></include>

    <include><name>sample_box_5</name><uri>model://manipulation_box</uri><pose>1.1 3.8 0.94 0 0 0</pose></include>
    <include><name>sample_cylinder_5</name><uri>model://manipulation_cylinder</uri><pose>1.5 3.8 0.94 0 0 0</pose></include>
    <include><name>sample_sphere_5</name><uri>model://manipulation_sphere</uri><pose>1.3 4 0.94 0 0 0</pose></include>
    <include><name>sample_block_5</name><uri>model://manipulation_block</uri><pose>1.1 4.2 0.94 0 0 0</pose></include>
    <include><name>sample_bottle_5</name><uri>model://manipulation_bottle</uri><pose>1.5 4.2 0.94 0 0 0</pose></include>
  </world>
</sdf>