        <collision name="south_right"><pose>15 -10.5 4.5 0 0 0</pose><geometry><box><size>12 0.2 9</size></box></geometry></collision>
        <visual name="south_right"><pose>15 -10.5 4.5 0 0 0</pose><geometry><box><size>12 0.2 9</size></box></geometry><material><ambient>0.48 0.5 0.52 1</ambient><diffuse>0.65 0.67 0.68 1</diffuse></material></visual>
        <collision name="entrance_header"><pose>7 -10.5 7 0 0 0</pose><geometry><box><size>4 0.2 4</size></box></geometry></collision>
        <visual name="entrance_header"><pose>7 -10.5 7 0 0 0</pose><geometry><box><size>4 0.2 4</size></box></geometry><material><ambient>0.48 0.5 0.52 1</ambient><diffuse>0.65 0.67 0.68 1</diffuse></material></visual>
