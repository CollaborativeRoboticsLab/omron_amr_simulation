<?xml version="1.0"?>
<sdf version="1.9">
  <world name="industrial-warehouse">
    <physics name="default" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <light name="warehouse_light_1" type="point">
      <pose>0 0 8.5 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse>
      <attenuation><range>35</range><constant>0.5</constant><linear>0.02</linear><quadratic>0.001</quadratic></attenuation>
    </light>
    <light name="warehouse_light_2" type="point">
      <pose>14 0 8.5 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse>
      <attenuation><range>35</range><constant>0.5</constant><linear>0.02</linear><quadratic>0.001</quadratic></attenuation>
    </light>

    <include><name>floor_1</name><uri>https://fuel.ignitionrobotics.org/1.0/OpenRobotics/models/aws_robomaker_warehouse_GroundB_01</uri><pose>0 0 -0.090092 0 0 0</pose></include>
    <include><name>floor_2</name><uri>https://fuel.ignitionrobotics.org/1.0/OpenRobotics/models/aws_robomaker_warehouse_GroundB_01</uri><pose>14 0 -0.090092 0 0 3.141592653589793</pose></include>

    <model name="warehouse_perimeter">
      <static>true</static>
      <link name="walls">
