        <collision name="north"><pose>7 10.5 4.5 0 0 0</pose><geometry><box><size>28 0.2 9</size></box></geometry></collision>
        <visual name="north"><pose>7 10.5 4.5 0 0 0</pose><geometry><box><size>28 0.2 9</size></box></geometry><material><ambient>0.48 0.5 0.52 1</ambient><diffuse>0.65 0.67 0.68 1</diffuse></material></visual>
        <collision name="south_left"><pose>-1 -10.5 4.5 0 0 0</pose><geometry><box><size>12 0.2 9</size></box></geometry></collision>
